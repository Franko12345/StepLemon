<?xml version="1.0" encoding="utf-8"?>
<!--
  StepLemon logo v2 — clean lemon, no faces.
  Goal: unmistakably a lemon. Oval shape, leaf top-right, stem nub, tip bumps.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem nub -->
    <path
        android:fillColor="#6B4423"
        android:pathData="M53,28 C 53,24 55,22 56,22 C 57,22 56,26 55,30 Z"/>

    <!-- Leaf behind, top-right -->
    <path
        android:fillColor="#66BB6A"
        android:pathData="M55,32
                          C 65,22 84,22 92,30
                          C 88,40 76,46 64,42
                          C 60,40 57,36 55,32 Z"/>
    <!-- Leaf central vein -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M58,33 C 70,32 82,30 90,28"
        android:strokeWidth="1.5"
        android:strokeColor="#2E7D32"/>

    <!-- Main lemon body: oval with pointy tips -->
    <path
        android:fillColor="#F4E04D"
        android:pathData="M54,36
                          C 36,36 22,50 24,68
                          C 26,84 38,90 54,90
                          C 70,90 82,84 84,68
                          C 86,50 72,36 54,36 Z"/>

    <!-- Left tip pointy -->
    <path
        android:fillColor="#D4C42E"
        android:pathData="M22,68 C 18,68 16,69 17,71 C 19,72 22,70 22,68 Z"/>
    <!-- Right tip pointy -->
    <path
        android:fillColor="#D4C42E"
        android:pathData="M86,68 C 90,68 92,69 91,71 C 89,72 86,70 86,68 Z"/>

    <!-- Bottom shadow band — adds depth -->
    <path
        android:fillColor="#C9B728"
        android:pathData="M28,76
                          C 32,86 42,90 54,90
                          C 66,90 76,86 80,76
                          C 76,84 66,86 54,86
                          C 42,86 32,84 28,76 Z"/>

    <!-- Top-left specular highlight -->
    <path
        android:fillColor="#FFF59D"
        android:pathData="M36,46
                          C 38,44 42,44 46,46
                          C 42,50 38,50 36,46 Z"/>
</vector>
<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lemon_primary" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/lemon_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lemon_surface_alt" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/lemon_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lemon_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/lemon_outline_dim" />
        </shape>
    </item>
</selector>
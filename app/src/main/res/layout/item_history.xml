<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stat_card"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/item_day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon"
            android:textColor="@color/lemon_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/item_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8/24"
            android:textColor="@color/lemon_text_dim"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/item_steps_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/lemon_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="steps"
                android:textColor="@color/lemon_text_dim"
                android:textSize="13sp"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>
            <ImageView
                android:id="@+id/item_check"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_target"
                android:visibility="gone"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_map"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/item_distance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="—"
                android:textColor="@color/lemon_primary"
                android:textSize="13sp"/>
        </LinearLayout>

        <View
            android:id="@+id/item_progress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_progress_bar"/>

    </LinearLayout>

</LinearLayout>